# Base URL for the API — override in .env.local for local dev
VITE_API_BASE_URL=https://jsonplaceholder.typicode.com

# Okta OIDC configuration — required for authentication
VITE_OKTA_CLIENT_ID=
VITE_OKTA_ISSUER=
VITE_OKTA_SCOPES=openid,profile,email

# Set to true only for local development to bypass Okta auth
# Never set to true in production
VITE_AUTH_BYPASS=false
